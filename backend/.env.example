# ================================================================
# SMART STUDENT ATTENDANCE SYSTEM - ENVIRONMENT CONFIGURATION
# ================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_attendance?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smart_attendance

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_smart_attendance_system_2025_secure_key
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------
# NODEMAILER GMAIL SMTP CONFIGURATION
# ----------------------------------------------------------------
# How to get Gmail App Password:
# 1. Enable 2-Step Verification in your Google Account:
#    https://myaccount.google.com/security
# 2. Go to "App passwords":
#    https://myaccount.google.com/apppasswords
# 3. Create a new app password named "Smart Attendance"
# 4. Copy the generated 16-character password (e.g., "abcd efgh ijkl mnop")
# 5. Paste below (without spaces):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Smart Attendance System <no-reply@smartattendance.edu>"

# Frontend Client URL (For CORS & Welcome Links)
CLIENT_URL=http://localhost:5173

# QR Code Token Secret
QR_SECRET=qr_session_secret_attendance_system_secure_token
